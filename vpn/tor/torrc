###############
# ENTRY GUARDS
###############
UseEntryGuards 1
NumEntryGuards 2

#############################
# EXIT POLICY - ANTI-ADS
#############################
# Low-CPM countries with stronger GDPR posture
# and lower advertiser targeting pressure
ExitNodes {de},{it},{ad},{mc},{al},{mm},{mv},{vn},{uz}

# Exclude ad-premium markets and Anglosphere regions
ExcludeNodes {ch},{us},{gb},{au},{ca},{fr},{nl},{be},{ie},{se},{no},{dk},{fi},{jp},{kr},{cn},{ru}

# Enforce strict use of the selected list
StrictNodes 1

################################
# TOPOLOGY / OPSEC
################################
EnforceDistinctSubnets 1

################################
# CIRCUIT LIFETIME (ANTI-PROFILING)
################################
NewCircuitPeriod 300
MaxCircuitDirtiness 1800
CircuitBuildTimeout 30
MaxClientCircuitsPending 100

################################
# PADDING (ANTI TRAFFIC ANALYSIS)
################################
ConnectionPadding 1
ReducedConnectionPadding 0

################################
# SOCKS + STRONG ISOLATION
################################
SocksPort 9050 IsolateDestAddr IsolateDestPort IsolateSOCKSAuth

################################
# BASE
################################
ClientOnly 1
DataDirectory /var/lib/tor
SafeSocks 1
DNSPort 0
AutomapHostsOnResolve 0

################################
# LOGGING (OPERATIONAL DEBUG)
################################
Log notice file /var/log/tor/notices.log
Log info file /var/log/tor/info.log