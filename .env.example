# === Dominio e TLS ===
# MY_DOMAIN: lascia vuoto per accesso solo via IP
MY_DOMAIN=
MY_EMAIL=
# TLS_MODE: selfsigned | letsencrypt | cloudpanel
TLS_MODE=selfsigned
# Giorni validità certificato self-signed
TLS_CERT_DAYS=365

# === Blacklist DNS ===
BLACKLIST_URL=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
OUTPUT_FILE=/app/unbound/blacklist.conf

# === Persistenza ===
INSTALL_SYSTEMD=1
INSTALL_CRON=1
BLACKLIST_CRON_SCHEDULE=0 */6 * * *

AUTH_MODE=basic
USERS_FILE=/app/app/users.yaml
POLICY_FILE=/app/app/policy.yaml
RATE_LIMIT_RPM=120
RATE_LIMIT_WINDOW_SEC=60
AUTH_LOG_FILE=/app/logs/auth.log
TRAFFIC_LOG_FILE=/app/logs/traffic.log

MITMPROXY_BIND_IP=0.0.0.0
MITMPROXY_BIND_PORT=8080

UNBOUND_BIND_IP=127.0.0.1
UNBOUND_DNS_PORT=5353
UNBOUND_DOT_BIND_IP=127.0.0.1
UNBOUND_DOT_PORT=853
# Directory montata nel container Unbound con i cert TLS
# Generata automaticamente da init/generate-certs.sh
UNBOUND_TLS_CERTS_DIR=./ssl-certificates

PRIVOXY_BIND_IP=127.0.0.1
PRIVOXY_BIND_PORT=8118
PRIVOXY_UPSTREAM_PORT=8118
PRIVOXY_LISTEN_IP=127.0.0.1
PRIVOXY_LISTEN_PORT=8118
PRIVOXY_SOCKET_TIMEOUT=300
PRIVOXY_FORWARDED_CONNECT_RETRIES=1
PRIVOXY_MAX_CLIENT_CONNECTIONS=1024
PRIVOXY_KEEP_ALIVE_TIMEOUT=5
PRIVOXY_TOLERATE_PIPELINING=1

# === Tor ===
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
# Exit nodes: paesi a basso CPM, GDPR forte, no advertiser premium
# Formato: {codice_paese} separati da virgola
TOR_EXIT_NODES={de},{it},{ad},{mc},{al},{mm},{mv},{vn},{uz}
TOR_EXCLUDE_NODES={ch},{us},{gb},{au},{ca},{fr},{nl},{be},{ie},{se},{no},{dk},{fi},{jp},{kr},{cn},{ru}
TOR_STRICT_NODES=1
# Circuit anti-profiling (secondi)
TOR_NEW_CIRCUIT_PERIOD=300
TOR_MAX_CIRCUIT_DIRTINESS=1800
TOR_CIRCUIT_BUILD_TIMEOUT=30
# Connection padding (anti traffic analysis): 1=on 0=off
TOR_CONNECTION_PADDING=1
