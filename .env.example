BLACKLIST_URL=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
OUTPUT_FILE=/app/unbound/blacklist.conf

INSTALL_SYSTEMD=1
INSTALL_CRON=1
BLACKLIST_CRON_SCHEDULE=0 */6 * * *

AUTH_MODE=basic
USERS_FILE=/app/app/users.yaml
POLICY_FILE=/app/app/policy.yaml
RATE_LIMIT_RPM=120
RATE_LIMIT_WINDOW_SEC=60
AUTH_LOG_FILE=/app/logs/auth.log
TRAFFIC_LOG_FILE=/app/logs/traffic.log

MITMPROXY_BIND_IP=0.0.0.0
MITMPROXY_BIND_PORT=8080

UNBOUND_BIND_IP=127.0.0.1
UNBOUND_DNS_PORT=5353

PRIVOXY_BIND_IP=127.0.0.1
PRIVOXY_BIND_PORT=8118
PRIVOXY_UPSTREAM_PORT=8118
PRIVOXY_LISTEN_IP=127.0.0.1
PRIVOXY_LISTEN_PORT=8118
PRIVOXY_SOCKET_TIMEOUT=300
PRIVOXY_FORWARDED_CONNECT_RETRIES=1
PRIVOXY_MAX_CLIENT_CONNECTIONS=1024
PRIVOXY_KEEP_ALIVE_TIMEOUT=5
PRIVOXY_TOLERATE_PIPELINING=1

TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
