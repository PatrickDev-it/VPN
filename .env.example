# =============================================================================
# .env.example — VPS Proxy Stack Environment Configuration
#
# Copy this file to .env and fill in the values before running bootstrap.sh.
# .env is git-ignored and must never be committed.
# =============================================================================

# === Domain and TLS ===
# MY_DOMAIN: public hostname for TLS certificate. Leave empty for IP-only access.
MY_DOMAIN=
# MY_EMAIL: required by Let's Encrypt for certificate renewal notifications.
MY_EMAIL=
# TLS_MODE: how to provision the TLS certificate.
#   selfsigned  — generate a self-signed cert via openssl (default, zero deps)
#   letsencrypt — use certbot ACME (requires MY_DOMAIN and MY_EMAIL)
#   cloudpanel  — reuse an existing cert managed by CloudPanel
TLS_MODE=selfsigned
# TLS_CERT_DAYS: validity period (days) for self-signed certificates.
TLS_CERT_DAYS=365

# === DNS blacklist ===
# BLACKLIST_URL: upstream hosts-format block list fetched by the cron job every 6 h.
BLACKLIST_URL=https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts
# OUTPUT_FILE: destination path inside the container where the block list is written.
OUTPUT_FILE=/app/unbound/blacklist.conf

# === Persistence ===
# INSTALL_SYSTEMD: 1 = create and enable vps-proxy-stack.service via systemd on bootstrap.
INSTALL_SYSTEMD=1
# INSTALL_CRON: 1 = register the blacklist-update cron job on bootstrap.
INSTALL_CRON=1
# BLACKLIST_CRON_SCHEDULE: cron expression for blacklist refresh (default: every 6 hours).
BLACKLIST_CRON_SCHEDULE=0 */6 * * *
# INSTALL_CLOUDPANEL: 1 = install CloudPanel during setup-vps.sh (interactive install skipped by default).
INSTALL_CLOUDPANEL=0

# === mitmproxy / Gatekeeper ===
# MITMPROXY_IMAGE: local tag by default; CD overrides this with a GHCR digest.
MITMPROXY_IMAGE=vps-proxy-stack-mitmproxy:local
# AUTH_MODE: authentication method for proxy clients.
#   basic — HTTP Basic (username:password, SHA256-hashed in users.yaml)
#   token — Bearer token or X-Proxy-Token header
AUTH_MODE=basic
# USERS_FILE: path to users.yaml inside the container.
USERS_FILE=/app/app/users.yaml
# POLICY_FILE: path to policy.yaml inside the container.
POLICY_FILE=/app/app/policy.yaml
# RATE_LIMIT_RPM: global default requests-per-minute cap per user (per-user override in users.yaml).
RATE_LIMIT_RPM=120
# RATE_LIMIT_WINDOW_SEC: sliding window duration for rate limiting (seconds).
RATE_LIMIT_WINDOW_SEC=60
# CONFIG_RELOAD_INTERVAL_SEC: how often Gatekeeper polls policy.yaml and users.yaml for changes.
CONFIG_RELOAD_INTERVAL_SEC=30
# AUTH_LOG_FILE: path to the authentication event log inside the container.
AUTH_LOG_FILE=/app/logs/auth.log
# TRAFFIC_LOG_FILE: path to the traffic log (method, host, path, status, bytes) inside the container.
TRAFFIC_LOG_FILE=/app/logs/traffic.log

# MITMPROXY_BIND_IP: IP address mitmproxy listens on (0.0.0.0 = all interfaces).
MITMPROXY_BIND_IP=0.0.0.0
# MITMPROXY_BIND_PORT: port mitmproxy listens on for incoming proxy connections.
MITMPROXY_BIND_PORT=8080

# === Unbound (DNS resolver) ===
# UNBOUND_BIND_IP: IP address Unbound binds to inside the container.
UNBOUND_BIND_IP=127.0.0.1
# UNBOUND_DNS_PORT: UDP/TCP port Unbound listens on for DNS queries (plain DNS).
UNBOUND_DNS_PORT=5353
# UNBOUND_DOT_BIND_IP: IP for Unbound's DNS-over-TLS listener.
UNBOUND_DOT_BIND_IP=127.0.0.1
# UNBOUND_DOT_PORT: port for Unbound's DNS-over-TLS listener (RFC 7858 default: 853).
UNBOUND_DOT_PORT=853
# UNBOUND_TLS_CERTS_DIR: host directory mounted into the Unbound container for TLS certs.
#   Automatically populated by init/generate-certs.sh.
UNBOUND_TLS_CERTS_DIR=./ssl-certificates

# === Privoxy (HTTP→SOCKS5 bridge) ===
# Safe to leave these at defaults unless you need to tune connection limits.
# PRIVOXY_BIND_IP / PRIVOXY_BIND_PORT: external listen address for Docker port mapping.
PRIVOXY_BIND_IP=127.0.0.1
PRIVOXY_BIND_PORT=8118
# PRIVOXY_UPSTREAM_PORT: port used when communicating between mitmproxy and Privoxy.
PRIVOXY_UPSTREAM_PORT=8118
# PRIVOXY_LISTEN_IP / PRIVOXY_LISTEN_PORT: address Privoxy binds to inside the container.
# Bind all container interfaces so mitmproxy can reach the service network; the host mapping stays loopback-only.
PRIVOXY_LISTEN_IP=0.0.0.0
PRIVOXY_LISTEN_PORT=8118
# PRIVOXY_SOCKET_TIMEOUT: seconds before Privoxy closes an idle connection.
PRIVOXY_SOCKET_TIMEOUT=300
# PRIVOXY_FORWARDED_CONNECT_RETRIES: how many times Privoxy retries a failed CONNECT.
PRIVOXY_FORWARDED_CONNECT_RETRIES=1
# PRIVOXY_MAX_CLIENT_CONNECTIONS: maximum simultaneous client connections to Privoxy.
PRIVOXY_MAX_CLIENT_CONNECTIONS=1024
# PRIVOXY_KEEP_ALIVE_TIMEOUT: keep-alive idle timeout (seconds).
PRIVOXY_KEEP_ALIVE_TIMEOUT=5
# PRIVOXY_TOLERATE_PIPELINING: 1 = accept pipelined HTTP requests (improves throughput).
PRIVOXY_TOLERATE_PIPELINING=1

# === Tor ===
# TOR_SOCKS_HOST: hostname of the Tor SOCKS5 proxy (service name in Docker Compose).
TOR_SOCKS_HOST=tor
# TOR_SOCKS_PORT: port Tor listens on for SOCKS5 connections.
TOR_SOCKS_PORT=9050

# TOR_EXIT_NODES: comma-separated ISO 3166-1 alpha-2 country codes in braces for preferred exits.
#   Tor will prefer these countries but is not guaranteed to use them unless StrictNodes 1 is set.
#   Default: low-CPM countries with GDPR-friendly legislation.
TOR_EXIT_NODES={de},{it},{ad},{mc},{al},{mm},{mv},{vn},{uz}

# TOR_EXCLUDE_NODES: countries to never use as exit nodes.
#   Default: 5-Eyes, 9-Eyes, 14-Eyes, mandatory data-retention jurisdictions,
#   and high-CPM advertising markets.
TOR_EXCLUDE_NODES={ch},{us},{gb},{au},{ca},{fr},{nl},{be},{ie},{se},{no},{dk},{fi},{jp},{kr},{cn},{ru}

# TOR_CONTROL_ENABLED: 1 = enable Tor ControlPort so Gatekeeper can send NEWNYM signals.
#   Required for per-user exit country rotation. Needs stem>=1.8.2 (included in requirements.txt).
#   NOTE: NEWNYM rotates circuits globally, not per-user (Tor architecture limitation).
TOR_CONTROL_ENABLED=0

# TOR_CONTROL_HOST: hostname of the Tor ControlPort (service name in Docker Compose).
TOR_CONTROL_HOST=tor

# TOR_CONTROL_PORT: port the Tor ControlPort listens on.
TOR_CONTROL_PORT=9051
