# =============================================================================
# .gitignore — VPN Platform
# =============================================================================

# --- Secrets and credentials ---
.env
vpn/app/users.yaml
vpn/ssl-certificates/
ssl-certificates/

# --- Runtime artifacts ---
vpn/logs/
logs/
vpn/privoxy/config

# --- Python ---
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# --- Terraform state (never commit — use remote backend in production) ---
infra/terraform/**/.terraform/
infra/terraform/**/.terraform.lock.hcl
infra/terraform/**/terraform.tfstate
infra/terraform/**/terraform.tfstate.backup
infra/terraform/**/*.tfvars
infra/terraform/**/*.tfvars.json

# --- Local patch history ---
session.md
